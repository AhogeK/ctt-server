#!/usr/bin/env bash
# The change does not leave the machine before it has passed what CI will run.
# Deleting a branch removes refs and pushes nothing, so there is no change for
# the gate to judge — and running it would spend the whole suite to send a
# deletion.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  # All zeros means this line deletes a remote ref.
  case "$local_sha" in
  *[!0]*) pushing=1 ;;
  esac
done

[ "$pushing" -eq 1 ] || exit 0
exec scripts/preflight.sh
