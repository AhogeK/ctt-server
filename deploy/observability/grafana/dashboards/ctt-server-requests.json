{
  "uid": "ctt-server-requests",
  "title": "CTT Server — requests and sync",
  "description": "Request mix, the two ratios and the latency percentile the alert rules evaluate, the sync path they do not cover, and the rate-limit rejections behind them. Contract lines are drawn from the deployment contract, not from the rule: a rule that differs says why in its own annotation.",
  "tags": ["ctt-server", "red", "provided"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "links": [
    {"title": "Background work", "url": "/d/ctt-server-background", "type": "link"},
    {"title": "Edge and hosts", "url": "/d/ctt-edge-hosts", "type": "link"}
  ],
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "description": "The denominator of both ratio rules and the first thing to look at when either fires.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "2xx", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=~\"2..\"}[5m]))", "legendFormat": "2xx"},
        {"refId": "3xx", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=~\"3..\"}[5m]))", "legendFormat": "3xx"},
        {"refId": "4xx", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=~\"4..\"}[5m]))", "legendFormat": "4xx"},
        {"refId": "5xx", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=~\"5..\"}[5m]))", "legendFormat": "5xx"}
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx ratio against the 0.5% contract",
      "description": "Alert Http5xxRatioHigh evaluates the same expression with a traffic guard; the dashed line is the deployment contract (5xx ≤ 0.5%/month).",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "contract 0.5%"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=~\"5..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"ctt-server\"}[5m]))", "legendFormat": "5xx ratio"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "vector(0.005)", "legendFormat": "contract 0.5%"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency against the 300 ms contract",
      "description": "Same percentile as alert HttpP95LatencyHigh. The buckets exist because management.metrics.distribution.percentiles-histogram enables them for http.server.requests.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "contract 300 ms"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"ctt-server\"}[5m])))", "legendFormat": "p95"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "vector(0.3)", "legendFormat": "contract 300 ms"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "429 ratio against the 10% alert threshold",
      "description": "No SLO covers 429; the rule's 10% is a judgement value, so the line here is the alert threshold rather than a contract.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "alert threshold 10%"},
            "properties": [
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}
            ]
          }
        ]
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum(rate(http_server_requests_seconds_count{job=\"ctt-server\", status=\"429\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=\"ctt-server\"}[5m]))", "legendFormat": "429 ratio"},
        {"refId": "C", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "vector(0.1)", "legendFormat": "alert threshold 10%"}
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Sync outcomes per second",
      "description": "No alert watches sync outcomes: a conflict is a normal result of the protocol, and a sustained FAILURE rate is only interpretable next to the client side.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum by (outcome) (rate(cttserver_business_sync_count_total{job=\"ctt-server\"}[5m]))", "legendFormat": "{{outcome}}"}
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Sync payload mix per second",
      "description": "EMPTY means the push carried nothing new after conflict resolution — the SKIP_UNCHANGED decision, not a failure.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true, "stacking": {"mode": "normal", "group": "A"}}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum by (payload) (rate(cttserver_business_sync_count_total{job=\"ctt-server\"}[5m]))", "legendFormat": "{{payload}}"}
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Sync duration p95",
      "description": "The sync timer publishes histogram buckets for exactly this percentile; the HTTP p95 above does not break down by endpoint.",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(cttserver_business_sync_duration_seconds_bucket{job=\"ctt-server\"}[5m])))", "legendFormat": "{{operation}}"}
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Rate-limit rejections per second by type",
      "description": "Rejection type names the limiter that fired: IP, USER, EMAIL or the GLOBAL ceiling. A GLOBAL series means the ceiling, not a noisy client.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "never", "spanNulls": true}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "editorMode": "code", "range": true, "expr": "sum by (type) (rate(cttserver_business_ratelimit_rejections_total{job=\"ctt-server\"}[5m]))", "legendFormat": "{{type}}"}
      ]
    }
  ]
}
