{
  "uid": "ctt-local",
  "title": "CTT local stack",
  "tags": ["ctt", "local"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Health probe (1 = up)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "probe_success", "legendFormat": "{{instance}}" }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "type": "timeseries",
      "title": "Probe duration (s)",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "probe_duration_seconds", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
