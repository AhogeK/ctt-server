# Edge upstream: the blue colour of the staging stack.
#
# The site block imports `active.caddy`, a symlink to one of the files in this
# directory, so moving traffic between colours is a config reload rather than a
# restart of the process that holds the connections. `switch-colour.sh` repoints
# the symlink and reloads; the old configuration keeps serving until the new one
# is accepted, and a rejected one changes nothing.
#
# The same two headers and timeouts as the local stack: a rehearsal is only
# evidence if the edge between the caller and the colours behaves the same way.
reverse_proxy 127.0.0.1:28081 {
	# TLS terminates at the access host, so this request is plain HTTP even
	# though the caller used HTTPS. Caddy would otherwise set the header to its
	# own scheme (http) and the application would treat an HTTPS request as
	# insecure — non-Secure cookies, http-only links. This assumes nothing but
	# the edge can reach :28080; to exercise the insecure branch on purpose,
	# call the colour port directly.
	header_up X-Forwarded-Proto https

	# Keep the client address chain honest: Caddy appends the immediate peer to
	# X-Forwarded-For, and the application reads the chain right-to-left while
	# skipping the proxies it trusts.
	transport http {
		dial_timeout 5s
		response_header_timeout 30s
	}
}
