# The local stack: what `deploy/lib/switch-colour.sh` and `deploy/lib/release.sh`
# need to know about it (P3.6).
#
# Sourced by `deploy/lib/load-stack.sh`; `CTT_STACK_FILE` defaults to this file,
# so `./deploy/local/release.sh` behaves exactly as it always has. The staging
# stack sets the same keys to different values in `deploy/staging/stack.env`;
# neither script contains a port.
CTT_STACK_NAME=local

# The Compose files, in merge order. `release.sh` runs them as
# `docker compose -f … -f …`.
CTT_COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.local.yaml"

# The edge: which container holds the running configuration, where its admin
# endpoint answers, which directory the site block imports its upstream from,
# and which port the public path is reached on.
CTT_EDGE_CONTAINER=ctt-edge
CTT_EDGE_ADMIN=127.0.0.1:2019
CTT_UPSTREAM_DIR=deploy/local/edge-upstream
CTT_EDGE_PUBLIC_PORT=18080

# Caddy reads these from its own environment (`{$CADDY_ADMIN}` and
# `{$CADDY_SITE}` in deploy/edge/Caddyfile).
CADDY_ADMIN=127.0.0.1:2019
CADDY_SITE=:18080

# The two colours: the port each serves on and the management port its readiness
# endpoint answers on.
CTT_BLUE_PORT=18081
CTT_BLUE_MANAGEMENT=8081
CTT_GREEN_PORT=18082
CTT_GREEN_MANAGEMENT=8082

# The observation window reads its probes from this Prometheus, and addresses
# the public-path probe by this job name (it is the same name on the deployment
# stack, so the dashboards read one series in both).
CTT_PROMETHEUS_URL=http://127.0.0.1:9090
CTT_PROBE_JOB=blackbox-public
