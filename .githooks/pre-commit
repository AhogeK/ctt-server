#!/usr/bin/env bash
# Nothing that changes code gets committed unverified: the same scoped gate CI
# runs (`scripts/preflight.sh`) runs here, so a red commit cannot be created and
# a red push cannot follow from it. A documentation-only commit still pays the
# cheap formatting check and nothing else — the gate reads the staged range, so
# it stays scoped on its own.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
printf '%s\n' "$staged" | grep -Eq '(^src/|\.kts$|^gradle/|^gradle\.properties$|^Dockerfile$|^\.dockerignore$|^\.github/scripts/)' ||
  exec ./gradlew -q spotlessCheck
exec ./scripts/preflight.sh
