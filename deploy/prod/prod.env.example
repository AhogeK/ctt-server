# Deployment facts for the production stack (P3.8).
#
# This file is an example. The real one lives on the deployment host as
# `deploy/prod/prod.env`, is listed in `.gitignore`, and is read by both colours
# through `env_file`. Nothing here is secret — credentials are rendered into
# `deploy/secrets/run/` and mounted as Compose secrets — the same rendered payload
# every other consumer on this host reads — but the values name one deployment,
# and this repository is public.
#
# A missing file fails the start (Compose refuses an absent env_file) instead of
# silently falling back to a development default.

# The production GitHub OAuth App. The client *secret* is a Compose secret.
GITHUB_CLIENT_ID=

# Public origins. CORS_ALLOWED_ORIGINS is optional; the profile falls back to
# FRONTEND_BASE_URL.
FRONTEND_BASE_URL=https://
CORS_ALLOWED_ORIGINS=

# WebAuthn. The RP ID is a long-lived commitment: every passkey is bound to it.
PASSKEY_RP_ID=
PASSKEY_ALLOWED_ORIGINS=https://

# Sender address on the verified Resend domain.
MAIL_FROM_ADDRESS=

# Optional: 180 is the profile default, 0 stops deletion (ADR-0002).
AUDIT_RETENTION_DAYS=180
