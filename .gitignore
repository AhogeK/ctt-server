.obsidian/

### Local Configuration (Security: Never commit sensitive data) ###
src/main/resources/application-local.yml
src/main/resources/application-local.yaml
src/main/resources/application-local.properties
.env
.env.*
!.env.example
*.env
# Stack files hold ports and container names, not secrets — `*.env` above would
# otherwise swallow them and a fresh clone could not start either stack.
!deploy/*/stack.env
.gstack/

# Python bytecode from the CI helper scripts
__pycache__/
*.pyc
.omo

# AI plan files (internal, not for public docs)
.sisyphus/
.omp/
.alma-snapshots

# Rendered compose secrets (P0.5); only the SOPS payload is committed
# `run/` is the live set; any `run-*` is a temporary render (for example when
# rendering the production payload next to the development one). Missing the
# wildcard once put a real credential in `git status` as an untracked file.
deploy/secrets/run*/

# Deployment-local scrape targets: the real list names the public hosts, the
# committed .example shows only the shape.
deploy/observability/prometheus/targets/*.json

# Edge upstream choice (P3.4): a runtime symlink `switch-colour.sh` repoints.
# The two variants it points at are committed; which one serves is state, not
# content, and a checkout that carried it would silently pin one colour.
deploy/local/edge-upstream/active.caddy
deploy/local/edge-upstream/active.caddy.new
# The staging stack keeps its own choice (P3.6), for the same reason.
deploy/staging/edge-upstream/active.caddy
deploy/staging/edge-upstream/active.caddy.new
# Dumps exist for the seconds a restore drill needs them; a committed dump would
# be a copy of real user rows in the repository.
deploy/staging/backups/
# The production stack (P3.8) keeps its own choice, and its deployment facts
# name one host: origins, the GitHub OAuth client id and the WebAuthn relying
# party. Committing them would publish one deployment as if it were the default.
deploy/prod/edge-upstream/active.caddy
deploy/prod/edge-upstream/active.caddy.new
deploy/prod/prod.env

