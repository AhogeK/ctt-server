# Environment Variables for Local Development
# Copy this file to .env and customize for your environment
# WARNING: Never commit .env to Git (it's in .gitignore)
#
# The container stack does not read secret values from this file: they come
# from the SOPS payload through Compose secrets (see docs/deployment-secrets.md).
# This file is what `./gradlew bootRun` and the shell exports use.

# PostgreSQL Configuration
POSTGRES_DB=ctt_server
POSTGRES_USER=ctt
POSTGRES_PASSWORD=your_local_password
POSTGRES_EXTERNAL_PORT=15432

# Redis Configuration
REDIS_PASSWORD=your_redis_password
REDIS_EXTERNAL_PORT=16379

# Database Connection (for application-local.yaml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ctt_server
DB_USERNAME=postgres
DB_PASSWORD=your_local_password

# Redis Connection (for application-local.yaml)
# Local development uses Redis db 0. Production uses a dedicated logical db
# configured by REDIS_DATABASE (db2 because db1 is occupied by another service).
REDIS_DATABASE=0
REDIS_HOST=localhost
REDIS_PORT=6379

# Mailpit SMTP (Local Development)
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=

# Mailpit External Ports (Docker Compose)
MAIL_SMTP_EXTERNAL_PORT=1025
MAIL_UI_EXTERNAL_PORT=8025

# App Server Ports (Docker Compose)
APP_PORT=8080
APP_EXTERNAL_PORT=8004

# Compose secrets are group-readable; keep this GID in sync with render.sh's SECRET_GID.
SECRET_GID=1000

# Resend SMTP API Key (Production)
RESEND_API_KEY=re_xxx

# Mail Sender Configuration
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=CTT Server

# JWT Secret Key (256+ bits recommended)
# Required: generate with `openssl rand -base64 48`
# JWT_SECRET_KEY=
# Comma-separated exact reverse-proxy IPs; leave empty to trust only the socket peer.
# TRUSTED_PROXY_ADDRESSES=

# Two-factor TOTP encryption key (base64, exactly 32 bytes; generate with: openssl rand -base64 32)
# Required in production. Leave unset for local development; an empty value is not treated as
# unset and would fail startup, so keep this line commented unless you have a real key.
# TOTP_ENCRYPTION_KEY=

# Passkey relying party. The RP ID must match the effective domain used by the browser and is a
# long-lived commitment; changing it invalidates every registered passkey. Origins are comma
# separated exact browser origins. Production must provide real values.
# PASSKEY_RP_ID=localhost
# PASSKEY_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Base URL (for email verification links)
FRONTEND_BASE_URL=http://localhost:5173

# Spring Profile
SPRING_PROFILES_ACTIVE=local

# GitHub OAuth (for social login)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# AES key for GitHub access tokens (base64, exactly 32 bytes; openssl rand -base64 32)
# Required: generate with `openssl rand -base64 32`
# OAUTH_TOKEN_ENCRYPTION_KEY=

# hCaptcha (Production - register at https://dashboard.hcaptcha.com)
# Local/Dev use official test keys hardcoded in application-local/dev.yaml
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
