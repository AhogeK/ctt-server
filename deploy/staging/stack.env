# The staging stack: what `deploy/lib/switch-colour.sh` and `deploy/lib/release.sh`
# need to know about it (P3.6).
#
# Sourced by `deploy/lib/load-stack.sh` when the caller sets
# `CTT_STACK_FILE=deploy/staging/stack.env`; the wrappers in this directory do
# that. Every value here exists because the local stack already uses the default
# for it: the two stacks run side by side on one host.
CTT_STACK_NAME=staging

# Compose's project name. It namespaces the volumes (so `postgres_data` here is
# a different volume from the local one) and the networks.
COMPOSE_PROJECT_NAME=ctt-staging

# Base stack, the host-network overlay, then this stack's names.
CTT_COMPOSE_FILES="-f docker-compose.yaml -f docker-compose.local.yaml -f deploy/staging/docker-compose.staging.yaml"

# The container the backup and restore drill talk to. It carries the same
# `POSTGRES_USER`/`POSTGRES_DB`/`POSTGRES_PASSWORD_FILE` the server did, so a
# dump can only come from the database this stack actually serves.
CTT_DB_CONTAINER=ctt-stg-postgres

# The data plane on its own ports, in its own database.
POSTGRES_DB=ctt_server_staging
POSTGRES_EXTERNAL_PORT=25432
REDIS_EXTERNAL_PORT=26379
MAIL_SMTP_EXTERNAL_PORT=2025
MAIL_UI_EXTERNAL_PORT=9025

# The edge: staging's container, admin endpoint, upstream directory and public
# port. Caddy reads the last two values of this block from its own environment.
CTT_EDGE_CONTAINER=ctt-stg-edge
CTT_EDGE_ADMIN=127.0.0.1:2029
CTT_UPSTREAM_DIR=deploy/staging/edge-upstream
CTT_EDGE_PUBLIC_PORT=28080
CADDY_ADMIN=127.0.0.1:2029
CADDY_SITE=:28080

# The two colours.
CTT_BLUE_PORT=28081
CTT_BLUE_MANAGEMENT=8181
CTT_GREEN_PORT=28082
CTT_GREEN_MANAGEMENT=8182

# The observation window reads this stack's Prometheus, and the public probe by
# this stack's job name (`deploy/staging/prometheus.yml`).
CTT_PROMETHEUS_URL=http://127.0.0.1:9190
CTT_PROBE_JOB=blackbox-staging
