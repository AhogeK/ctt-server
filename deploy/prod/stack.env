# The production stack: what `deploy/lib/switch-colour.sh` and
# `deploy/lib/release.sh` need to know about it (P3.8).
#
# Sourced by `deploy/lib/load-stack.sh` through the wrappers in this directory,
# and exported into `docker compose` because load-stack.sh sources it with
# `set -a`. The data-plane facts below are the documented layout from
# `docs/production-data-isolation.md`, not secrets: the host runs one PostgreSQL
# (`ctt_server_prod`, role `ctt_app`) and one Redis (database 2), both on
# loopback.
CTT_STACK_NAME=prod

COMPOSE_PROJECT_NAME=ctt-prod

CTT_COMPOSE_FILES="-f docker-compose.yaml -f deploy/prod/docker-compose.prod.yaml"

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ctt_server_prod
DB_USERNAME=ctt_app
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=2

# The edge: production's container, admin endpoint, upstream directory and
# public port. The deployment topology is
#   nginx (access host) -> frps -> frpc -> edge 127.0.0.1:18080 -> app
# so the tunnel forwards to the same loopback port the local stack uses; the
# admin endpoint stays on loopback and is only used to reload.
CTT_EDGE_CONTAINER=ctt-prod-edge
CTT_EDGE_ADMIN=127.0.0.1:2019
CTT_UPSTREAM_DIR=deploy/prod/edge-upstream
CTT_EDGE_PUBLIC_PORT=18080
CADDY_ADMIN=127.0.0.1:2019
CADDY_SITE=:18080

# The two colours. The management ports are the contract with the deployment
# host's Prometheus, which already scrapes 8081 as slot=blue and 8082 as
# slot=green. Green therefore serves the application on 8083: 8082 belongs to
# its management server, and the guard rejects a management port equal to it.
CTT_BLUE_PORT=8080
CTT_BLUE_MANAGEMENT=8081
CTT_GREEN_PORT=8083
CTT_GREEN_MANAGEMENT=8082

# The observation window reads the deployment host's Prometheus and addresses
# the public-path probe by the job name it already uses there.
CTT_PROMETHEUS_URL=http://127.0.0.1:9090
CTT_PROBE_JOB=blackbox-public
